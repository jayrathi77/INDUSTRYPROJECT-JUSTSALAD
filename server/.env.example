NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Add an official, verified Swiggy listing URL before enabling the link.
SWIGGY_LISTING_URL=
# Official WhatsApp Cloud API settings; leave blank until the business account is configured.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Delivery fees and tax are intentionally unconfigured until the business supplies rates.
# Payment provider credentials are intentionally omitted: checkout remains disabled.

{
  "name": "just-salad",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace client run build && npm --workspace server run build",
    "test": "npm --workspace server test && npm --workspace client test",
    "seed": "npm --workspace server run seed"
  },
  "devDependencies": {"concurrently":"^9.1.2","typescript":"^5.7.3"}
}
